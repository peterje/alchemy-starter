# Copy to `.env`. Alchemy reads it for `bun run dev`, deploys, and the tests; it is never committed.

# Local runs sign in against the WorkOS emulator that `bun run dev` starts on this port. The
# browser tests use 4101 and the integration tests 4102, so all three can run at once.
WORKOS_API_URL=http://localhost:4100
WORKOS_API_KEY=sk_test_default
WORKOS_CLIENT_ID=client_emulator
# Seals the session cookie: at least 32 characters. Append a generated one:
#   printf 'WORKOS_COOKIE_PASSWORD=%s\n' "$(openssl rand -hex 32)" >> .env
# WORKOS_COOKIE_PASSWORD=

# Where `bun run dev` serves the website and the API.
# PORT=1337
# API_PORT=1338

# Read by `bun run provision`, which stores them as GitHub secrets for CI. Previews use the WorkOS
# Staging environment and production the Production one; production is optional until the first
# merge. Capture these with the commands in AGENTS.md rather than pasting them.
# WORKOS_API_KEY_STAGING=
# WORKOS_CLIENT_ID_STAGING=
# WORKOS_API_KEY_PRODUCTION=
# WORKOS_CLIENT_ID_PRODUCTION=
