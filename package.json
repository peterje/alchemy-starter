{
  "name": "alchemy-starter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build apps/website",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "ci:provision": "alchemy deploy stacks/github.ts --stage infrastructure",
    "prepare": "lefthook install",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "bun --bun oxlint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.bun.json",
    "test:plugins": "node --experimental-strip-types --test packages/oxlint-plugins/*.rule.ts",
    "test:integration": "bun test test/chats.test.ts",
    "test:browser": "playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:plugins && bun run build"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.110",
    "@effect/platform-node": "4.0.0-rc.110",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@starter/contract": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "lefthook": "2.1.10",
    "oxfmt": "0.35.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite": "8.0.7"
  },
  "overrides": {
    "effect": "4.0.0-rc.110"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.0"
}
