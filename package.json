{
  "name": "alchemy-starter",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build apps/website",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "provision": "alchemy deploy stacks/database.ts --stage shared && alchemy deploy stacks/github.ts --stage shared --profile admin",
    "prepare": "lefthook install",
    "references": "sh scripts/sync-references.sh",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "bun --bun oxlint --deny-warnings . && knip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/website && tsc --noEmit -p tsconfig.bun.json",
    "test:plugins": "node --experimental-strip-types --test packages/oxlint-plugins/*.rule.ts",
    "test:unit": "bun test ./apps ./packages/contract",
    "test:integration": "WORKOS_API_URL=http://localhost:4102 bun test --timeout 120000 ./test",
    "test:browser": "playwright test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:plugins && bun run test:unit && bun run build"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260812.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@distilled.cloud/workos": "1.0.0-rc.13",
    "@playwright/test": "^1.62.1",
    "@starter/contract": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.14",
    "@workos/emulate": "^0.14.0",
    "knip": "6.39.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.35.0",
    "oxlint": "1.79.0",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vite": "8.0.7"
  },
  "overrides": {
    "effect": "4.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "bun@1.4.0"
}
